# Control bot token (@BotFather)
BOT_TOKEN=
# Telegram user id of the only person allowed to use the bot (@userinfobot)
OWNER_TELEGRAM_ID=
# Telegram app credentials from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Fernet key protecting the stored session and API keys. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Optional
DATA_DIR=data
WEB_ADDR=127.0.0.1:8787
