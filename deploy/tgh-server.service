# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/tgh-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tgh-server
#   journalctl --user -u tgh-server -f          # logs
# Adjust WorkingDirectory to the checkout (it must contain .env and, by default, data/).
[Unit]
Description=TelegramHelper (userbot + control bot + localhost dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/projects/telegram-helper-rs
ExecStart=%h/Documents/projects/telegram-helper-rs/target/release/tgh-server
Restart=on-failure
RestartSec=5
# Ctrl+C / SIGTERM save the session before exit; give it a moment.
TimeoutStopSec=15
# Hardening: the process only needs its own directory and the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/Documents/projects/telegram-helper-rs
ProtectHome=read-only

[Install]
WantedBy=default.target
